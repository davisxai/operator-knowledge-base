# Copy to .env.local and fill in what the project uses. Never commit the real file.
# Each block is one layer of the build stack. Leave a block empty if the project does not use that layer.

# 04 Database: Supabase (hosted or self-hosted)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 04 Database: Neon, or any plain Postgres connection string
DATABASE_URL=

# 02 Code: model keys used by the app itself (not by Claude Code, which has its own login)
ANTHROPIC_API_KEY=

# 08 Decisions: Jev by TypeSafe AI
TYPESAFE_API_KEY=

# 09 Memory: Mem0 platform
MEM0_API_KEY=

# 10 Integrations: Composio
COMPOSIO_API_KEY=

# 07 Deploy: only needed for CLI deploys. Workers Builds from GitHub needs no token in the repo.
CLOUDFLARE_API_TOKEN=
