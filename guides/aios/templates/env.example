# Copy to .env and fill in. Never commit the filled file.

# Database (Supabase): pooled URL for the dashboard, direct URL for the worker and migrations
DATABASE_URL=
DATABASE_URL_DIRECT=

# Anthropic
ANTHROPIC_API_KEY=

# Gmail: one OAuth client, one refresh token per mailbox (mint each with scripts/gmail-refresh-token.mjs)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_PRIMARY_REFRESH_TOKEN=
GMAIL_INTERNAL_REFRESH_TOKEN=
GMAIL_AUTOMATION_REFRESH_TOKEN=
SYNC_ACCOUNTS=primary,internal,automation

# The Obsidian vault folder on this machine
VAULT_PATH=

# Worker clock for cron jobs
TZ=America/New_York
